<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="inventory.managment.system.controller.MyRequestsController">
   <children>
      <TableView fx:id="requestsTable" prefHeight="350.0" prefWidth="580.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="60.0">
         <columns>
            <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="typeColumn" prefWidth="80.0" text="Type" />
            <TableColumn fx:id="itemNameColumn" prefWidth="120.0" text="Item ID" />
            <TableColumn fx:id="itemTypeColumn" prefWidth="100.0" text="Item Type" />
            <TableColumn fx:id="statusColumn" prefWidth="80.0" text="Status" />
            <TableColumn fx:id="dateColumn" prefWidth="140.0" text="Date" />
            <TableColumn fx:id="actionColumn" prefWidth="80.0" text="Action" />
         </columns>
      </TableView>
      <Label layoutX="14.0" layoutY="14.0" text="My Requests" textFill="#1a73e8">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button fx:id="homebtn" layoutX="472.0" layoutY="10.0" mnemonicParsing="false" onAction="#homebtnHundlear" prefHeight="35.0" styleClass="button-secondary" text="Home" AnchorPane.rightAnchor="10.0">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <graphic>
            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imageResourse/home.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
   </children>
</AnchorPane>
